<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ZipValidatorClassLib</PackageId>
    <Version>1.0.0</Version>
    <Authors>lewis.teoh</Authors>
    <Description>Validates Singapore eCTD zip package structure, hidden files, password-protected content, and PDF encryption.</Description>
    <PackageTags>eCTD;zip;validator;Singapore;HSA</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ZipValidatorClassLib.Tests\**" />
    <None Remove="ZipValidatorClassLib.Tests\**" />
    <EmbeddedResource Remove="ZipValidatorClassLib.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.8" />
    <PackageReference Include="ProDotNetZip" Version="1.20.0" />
  </ItemGroup>

</Project>
